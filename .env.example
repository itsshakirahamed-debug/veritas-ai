[TEMPLATE]
# Veritas Legal Environment Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Model used for review/draft when an API key is present (must be a currently available Claude model)
ANTHROPIC_MODEL=claude-haiku-4-5
# Set to false to use the docker-compose Qdrant instead of the default in-memory index
QDRANT_IN_MEMORY=true
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Embedding model used for the dense side of hybrid search
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
LOG_LEVEL=INFO
